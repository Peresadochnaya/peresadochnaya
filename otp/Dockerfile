# ============================================================================
# OpenTripPlanner 2.x — образ для построения маршрутов на карте
# ============================================================================
# Модуль OTP (OpenTripPlanner) предоставляет GraphQL API для multi-modal
# планирования маршрутов с использованием OSM-данных и GTFS-расписаний.
#
# Базовая версия НЕ запинена: обновление тега latest может сделать ранее
# собранный graph.obj несовместимым (otpSerializationVersionId). Версия OTP
# записывается в manifest.json графа, а scripts/build-graph.sh сверяет её
# с образом. Перед обновлением образа пересоберите граф.
# ============================================================================

FROM opentripplanner/opentripplanner:latest

LABEL maintainer="hackathon-team"
LABEL description="OpenTripPlanner (OTP) — сервис маршрутизации для карты"
LABEL version="2.11"

# ---------------------------------------------------------------------------
# Переменные окружения
# OTP_MODE=build  → собрать граф и завершиться
# OTP_MODE=serve  → запустить сервер маршрутизации (по умолчанию)
# JAVA_OPTS       → параметры JVM (по умолчанию: -Xmx4G)
# OTP_PORT        → порт сервера (по умолчанию: 8080)
# ---------------------------------------------------------------------------
ENV OTP_MODE=serve
ENV OTP_PORT=8080

# ---------------------------------------------------------------------------
# Конфиги кладём ВНЕ рабочей директории: она может быть смонтирована
# только для чтения. Entrypoint копирует их только при разовой сборке
# без подготовленного staging.
# ---------------------------------------------------------------------------
COPY config/ /otp/config/
COPY scripts/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

# ---------------------------------------------------------------------------
# Порт API
# ---------------------------------------------------------------------------
EXPOSE 8080

# ---------------------------------------------------------------------------
# Запуск: entrypoint выбирает режим (build/serve) по OTP_MODE
# ---------------------------------------------------------------------------
ENTRYPOINT ["/entrypoint.sh"]
CMD ["serve"]

