{
  "configVersion": "local",
  "updaters": [
    {
      "type": "stop-time-updater",
      "feedId": "2",
      "url": "http://realtime:8001/api/v1/raw_feed",
      "frequency": "10s"
    }
  ],
  "routingDefaults": {
    "walk": {
      "speed": 1.3,
      "reluctance": 4.0
    },
    "numItineraries": 5,
    "searchWindow": "PT2H",
    "transferSlack": "PT2M",
    "accessEgress": {
      "maxDuration": "PT30M"
    },
    "itineraryFilters": {
      "removeItinerariesWithSameRoutesAndStops": true
    }
  }
}
